# Copy this file to .env and replace every value marked change-me.
# .env is ignored by Git. Never commit real credentials.

# Local PostgreSQL started by docker compose (see docker-compose.yml).
POSTGRES_USER=unsaid
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=unsaid_dev
POSTGRES_PORT=5432

# Connection string used by Prisma and the application.
DATABASE_URL=postgresql://unsaid:change-me-local-only@localhost:5432/unsaid_dev
